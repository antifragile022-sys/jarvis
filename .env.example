# Скопируй этот файл в `.env` и заполни значения.

# --- LLM (Google Gemini) ---
# Получить ключ: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Модель Gemini (по умолчанию gemini-1.5-flash — быстрая и бесплатная в рамках лимитов)
GEMINI_MODEL=gemini-1.5-flash

# --- Speech-to-Text (Vosk) ---
# Путь до распакованной модели Vosk.
# Скачать русскую модель: https://alphacephei.com/vosk/models
#   - vosk-model-small-ru-0.22 (~45 MB, быстрая)
#   - vosk-model-ru-0.42      (~1.8 GB, точнее)
VOSK_MODEL_PATH=models/vosk-model-small-ru-0.22

# --- Wake word ---
# Через запятую — любое из этих слов будет считаться обращением.
WAKE_WORDS=джарвис,jarvis,эй джарвис

# --- TTS ---
# Имя голоса в Windows SAPI5 (можно оставить пустым — будет выбран первый русский).
# Посмотреть голоса: `python -m jarvis voices`
TTS_VOICE=
TTS_RATE=180
TTS_VOLUME=1.0

# --- Погода ---
# Город по умолчанию для команды "какая погода" без уточнения.
DEFAULT_CITY=Москва

# --- Микрофон ---
# Индекс устройства ввода (None = по умолчанию). Список: `python -m jarvis devices`
MIC_DEVICE=

# --- Прочее ---
# Папка для скриншотов (по умолчанию — папка "Pictures/Jarvis").
SCREENSHOTS_DIR=
# Уровень логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
